{
  "name": "balans-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Balans ERP — ko'p tashkilotli (multi-tenant) buxgalteriya, ERP va AI CFO SaaS platformasi",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:rules && npm run test:render && npm run test:seed",
    "test:rules": "tsx --tsconfig tsconfig.json scripts/verify-rules.ts",
    "test:render": "tsx --tsconfig tsconfig.json scripts/smoke-render.tsx",
    "test:seed": "tsx --tsconfig tsconfig.json scripts/check-seed.ts"
  },
  "dependencies": {
    "immer": "^10.2.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
